<script>
  /* Back-to-top button: shows while scrolling, fades out 3 s after scrolling stops. */
  (function () {
    var button = null;
    var hideTimer = 0;
    var queued = false;

    function getButton() {
      if (!button || !button.isConnected) button = document.getElementById('back-to-top');
      return button;
    }

    function update() {
      queued = false;
      var target = getButton();
      if (!target) return;
      if (window.scrollY <= 180) {
        target.classList.remove('is-visible');
        return;
      }
      target.classList.add('is-visible');
      clearTimeout(hideTimer);
      hideTimer = setTimeout(function () {
        target.classList.remove('is-visible');
      }, 3000);
    }

    window.addEventListener('scroll', function () {
      if (queued) return;
      queued = true;
      window.requestAnimationFrame(update);
    }, { passive: true });
  })();

  /* Chat widget: loads once the page is idle, never in the middle of a scroll. */
  (function () {
    if (!window.chatbase || window.chatbase('getState') !== 'initialized') {
      window.chatbase = function () {
        if (!window.chatbase.q) window.chatbase.q = [];
        window.chatbase.q.push(arguments);
      };
      window.chatbase = new Proxy(window.chatbase, {
        get: function (target, prop) {
          if (prop === 'q') return target.q;
          return function () {
            return target(prop, Array.prototype.slice.call(arguments));
          };
        },
      });
    }

    function loadChat() {
      var script = document.createElement('script');
      script.src = 'https://www.chatbase.co/embed.min.js';
      script.id = 'dxCY_mFoNPQu83GSntHvw';
      script.domain = 'www.chatbase.co';
      document.body.appendChild(script);
    }

    function scheduleChat() {
      setTimeout(function () {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadChat, { timeout: 5000 });
        } else {
          loadChat();
        }
      }, 3000);
    }

    if (document.readyState === 'complete') {
      scheduleChat();
    } else {
      window.addEventListener('load', scheduleChat);
    }
  })();
</script>

