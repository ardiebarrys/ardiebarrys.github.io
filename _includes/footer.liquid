<script>
  /* Back-to-top button: shows while scrolling, fades out 3 s after scrolling stops. */
  (function () {
    var button = null;
    var hideTimer = 0;
    var queued = false;

    function getButton() {
      if (!button || !button.isConnected) button = document.getElementById('back-to-top');
      return button;
    }

    function update() {
      queued = false;
      var target = getButton();
      if (!target) return;
      if (window.scrollY <= 180) {
        target.classList.remove('is-visible');
        return;
      }
      target.classList.add('is-visible');
      clearTimeout(hideTimer);
      hideTimer = setTimeout(function () {
        target.classList.remove('is-visible');
      }, 3000);
    }

    window.addEventListener('scroll', function () {
      if (queued) return;
      queued = true;
      window.requestAnimationFrame(update);
    }, { passive: true });
  })();

</script>
