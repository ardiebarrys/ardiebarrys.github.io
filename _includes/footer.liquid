<style>
  html,
  body {
    min-height: 100%;
    background:
      radial-gradient(circle at 8% 18%, rgba(183, 0, 183, 0.11), transparent 24rem),
      radial-gradient(circle at 92% 28%, rgba(36, 71, 168, 0.10), transparent 24rem),
      radial-gradient(circle at 12% 82%, rgba(14, 159, 122, 0.08), transparent 22rem),
      linear-gradient(90deg, #f7f8fb 0%, #ffffff 24%, #ffffff 76%, #f7f8fb 100%) !important;
    background-attachment: fixed !important;
  }

  body {
    position: relative;
    overflow-x: hidden;
    padding-bottom: 5rem !important;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: "";
    pointer-events: none;
    background-image:
      linear-gradient(rgba(11, 23, 79, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(183, 0, 183, 0.045) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(90deg, black 0%, transparent 26%, transparent 74%, black 100%);
    -webkit-mask-image: linear-gradient(90deg, black 0%, transparent 26%, transparent 74%, black 100%);
  }

  .post,
  .page,
  .container,
  main {
    background: transparent !important;
  }

  #back-to-top,
  .back-to-top,
  .vanilla-back-to-top,
  button[aria-label="Back to top"],
  button[title="Back to top"],
  a[aria-label="Back to top"],
  a[title="Back to top"] {
    width: 4rem !important;
    height: 4rem !important;
    right: 1.6rem !important;
    bottom: 4.7rem !important;
    z-index: 99999 !important;
    background: #111111 !important;
    color: #ffffff !important;
    border-radius: 999px !important;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28) !important;
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(0.4rem) !important;
    transition:
      opacity 0.45s ease,
      transform 0.45s ease !important;
  }

  #back-to-top.is-visible,
  .back-to-top.is-visible,
  .vanilla-back-to-top.is-visible,
  button[aria-label="Back to top"].is-visible,
  button[title="Back to top"].is-visible,
  a[aria-label="Back to top"].is-visible,
  a[title="Back to top"].is-visible {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }

  #back-to-top *,
  .back-to-top *,
  .vanilla-back-to-top * {
    color: #ffffff !important;
    fill: #ffffff !important;
  }

  footer,
  footer.fixed-bottom,
  .fixed-bottom {
    background-color: #1a1a1a !important;
    color: #ffffff !important;
    font-size: 0.85rem !important;
  }

  footer *,
  .fixed-bottom * {
    color: #ffffff !important;
  }

  #chatbase-bubble-button {
    left: 1.6rem !important;
    right: auto !important;
    bottom: 4.7rem !important;
    z-index: 99998 !important;
  }

  #chatbase-message-bubbles {
    display: none !important;
  }

  #custom-chatbase-greeting {
    position: fixed;
    left: 1.6rem;
    bottom: 9.4rem;
    z-index: 99998;
    max-width: min(660px, calc(100vw - 3.2rem));
    padding: 1rem 1.35rem;
    border-radius: 14px;
    background: #ffffff;
    color: #111111;
    font-size: 1rem;
    line-height: 1.35;
  }

  #custom-chatbase-greeting::after {
    position: absolute;
    left: 2.15rem;
    bottom: -0.68rem;
    width: 0;
    height: 0;
    content: "";
    border-left: 0.72rem solid transparent;
    border-right: 0.72rem solid transparent;
    border-top: 0.72rem solid #ffffff;
  }

  #chatbase-bubble-window {
    left: 1.6rem !important;
    right: auto !important;
    bottom: 9.4rem !important;
    width: min(420px, calc(100vw - 3.2rem)) !important;
    max-width: calc(100vw - 3.2rem) !important;
  }

  @media (max-width: 768px) {
    #back-to-top,
    .back-to-top,
    .vanilla-back-to-top,
    button[aria-label="Back to top"],
    button[title="Back to top"],
    a[aria-label="Back to top"],
    a[title="Back to top"] {
      width: 3.6rem !important;
      height: 3.6rem !important;
      right: 1rem !important;
      bottom: 4.7rem !important;
    }

    #chatbase-bubble-button {
      left: 1rem !important;
      right: auto !important;
      bottom: 4.7rem !important;
    }

    #custom-chatbase-greeting {
      left: 1rem;
      bottom: 9.1rem;
      max-width: calc(100vw - 2rem);
      padding: 0.9rem 1rem;
      font-size: 0.95rem;
    }

    #custom-chatbase-greeting::after {
      left: 2rem;
      bottom: -0.64rem;
    }

    #chatbase-bubble-window {
      position: fixed !important;
      left: 0.5rem !important;
      right: auto !important;
      top: 4.5rem !important;
      bottom: auto !important;
      width: calc(100vw - 1rem) !important;
      max-width: calc(100vw - 1rem) !important;
      height: calc(100vh - 10rem) !important;
      max-height: calc(100vh - 10rem) !important;
      border-radius: 16px !important;
      overflow: hidden !important;
      transform: none !important;
    }
  }

  @media (max-width: 420px) {
    #chatbase-bubble-window {
      left: 0.35rem !important;
      top: 4.25rem !important;
      width: calc(100vw - 0.7rem) !important;
      max-width: calc(100vw - 0.7rem) !important;
      height: calc(100vh - 9.5rem) !important;
      max-height: calc(100vh - 9.5rem) !important;
    }
  }
</style>

<script>
  (function () {
    var fadeTimer;
    var scrollThreshold = 180;

    var selectors = [
      "#back-to-top",
      ".back-to-top",
      ".vanilla-back-to-top",
      'button[aria-label="Back to top"]',
      'button[title="Back to top"]',
      'a[aria-label="Back to top"]',
      'a[title="Back to top"]'
    ];

    function getButtons() {
      return Array.prototype.slice.call(
        document.querySelectorAll(selectors.join(","))
      );
    }

    function hideButtons() {
      getButtons().forEach(function (button) {
        button.classList.remove("is-visible");
      });
    }

    function showButtonsWhileScrolling() {
      if (window.scrollY <= scrollThreshold) {
        hideButtons();
        return;
      }

      getButtons().forEach(function (button) {
        button.classList.add("is-visible");
      });

      clearTimeout(fadeTimer);

      fadeTimer = setTimeout(function () {
        hideButtons();
      }, 3000);
    }

    function start() {
      hideButtons();

      window.addEventListener("scroll", showButtonsWhileScrolling, {
        passive: true
      });

      var observer = new MutationObserver(function () {
        hideButtons();
      });

      observer.observe(document.body, {
        childList: true,
        subtree: true
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start);
    } else {
      start();
    }
  })();
</script>

<footer class="fixed-bottom">
  <div class="container mt-0">
    &copy; Copyright {{ site.time | date: "%Y" }} Ardie Barry Sailis.
  </div>
</footer>

<div id="custom-chatbase-greeting">
  Hi! I am an AI assistant. I'll answer any questions you may have.
</div>

<script>
  (function () {
    if (!window.chatbase || window.chatbase("getState") !== "initialized") {
      window.chatbase = function () {
        if (!window.chatbase.q) {
          window.chatbase.q = [];
        }

        window.chatbase.q.push(arguments);
      };

      window.chatbase = new Proxy(window.chatbase, {
        get: function (target, prop) {
          if (prop === "q") {
            return target.q;
          }

          return function () {
            return target(prop, Array.prototype.slice.call(arguments));
          };
        }
      });
    }

    function onLoad() {
      var script = document.createElement("script");
      script.src = "https://www.chatbase.co/embed.min.js";
      script.id = "dxCY_mFoNPQu83GSntHvw";
      script.domain = "www.chatbase.co";
      document.body.appendChild(script);
    }

    if (document.readyState === "complete") {
      onLoad();
    } else {
      window.addEventListener("load", onLoad);
    }
  })();

  document.addEventListener("DOMContentLoaded", function () {
    var greeting = document.getElementById("custom-chatbase-greeting");

    function hideGreeting() {
      if (greeting) {
        greeting.style.display = "none";
      }
    }

    document.addEventListener("click", function (event) {
      if (
        event.target.closest("#chatbase-bubble-button") ||
        event.target.closest("#custom-chatbase-greeting")
      ) {
        hideGreeting();
      }
    });

    setTimeout(hideGreeting, 8000);
  });
</script>
