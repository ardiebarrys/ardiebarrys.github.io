<style>
  /* Third-party widgets (back-to-top button, chat bubble) are added at runtime,
     so their styles stay inline where the CSS purge step cannot remove them. */
  #back-to-top {
    width: 3.4rem !important;
    height: 3.4rem !important;
    right: 1.25rem !important;
    bottom: 1.25rem !important;
    z-index: 99999 !important;
    background: #2563eb !important;
    color: #ffffff !important;
    border-radius: 999px !important;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.45) !important;
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(0.4rem) !important;
    transition: opacity 0.35s ease, transform 0.35s ease !important;
  }

  #back-to-top.is-visible {
    opacity: 1 !important;
    pointer-events: auto !important;
    transform: translateY(0) !important;
  }

  #back-to-top * {
    color: #ffffff !important;
    fill: #ffffff !important;
  }

  #chatbase-bubble-button {
    left: 1.25rem !important;
    right: auto !important;
    bottom: 1.25rem !important;
    z-index: 99998 !important;
    background-color: #2563eb !important;
  }

  #chatbase-message-bubbles {
    display: none !important;
  }

  #chatbase-bubble-window {
    left: 1.25rem !important;
    right: auto !important;
    bottom: 5.5rem !important;
    width: min(420px, calc(100vw - 2.5rem)) !important;
    max-width: calc(100vw - 2.5rem) !important;
  }

  @media (max-width: 768px) {
    #back-to-top {
      width: 3rem !important;
      height: 3rem !important;
      right: 1rem !important;
      bottom: 1rem !important;
    }

    #chatbase-bubble-button {
      left: 1rem !important;
      bottom: 1rem !important;
    }

    #chatbase-bubble-window {
      position: fixed !important;
      left: 0.5rem !important;
      top: 4.5rem !important;
      bottom: auto !important;
      width: calc(100vw - 1rem) !important;
      max-width: calc(100vw - 1rem) !important;
      height: calc(100vh - 6rem) !important;
      max-height: calc(100vh - 6rem) !important;
      border-radius: 16px !important;
      overflow: hidden !important;
      transform: none !important;
    }
  }
</style>

{% if page.url == '/' or page.url == '/publications/' or page.url == '/projects/' or page.url == '/talks/' or page.url == '/cv/' or page.url == '/contact/' or page.url == '/biography/' %}
<canvas id="site-stars" aria-hidden="true"></canvas>
<style>
  /* Faint star field behind the main pages, drawn once (no animation loop). */
  #site-stars {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 0;
    width: 100%;
    height: 100vh;
    height: 100lvh;
    pointer-events: none;
    will-change: transform;
  }
</style>
<script>
  (function () {
    var canvas = document.getElementById('site-stars');
    var context = canvas && canvas.getContext && canvas.getContext('2d');
    if (!context) return;

    var resizeTimer = 0;
    var lastWidth = 0;

    function draw() {
      var width = canvas.clientWidth;
      var height = canvas.clientHeight;
      /* Mobile toolbars change the height while scrolling; only redraw for real width changes. */
      if (!width || (width === lastWidth && canvas.height > 150)) return;
      lastWidth = width;
      var ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      context.setTransform(ratio, 0, 0, ratio, 0, 0);

      var count = width <= 680 ? 18 : Math.min(60, Math.round((width * height) / 36000));
      for (var i = 0; i < count; i += 1) {
        var cyan = Math.random() > 0.64;
        context.beginPath();
        context.arc(Math.random() * width, Math.random() * height, 0.9 + Math.random() * 1.05, 0, Math.PI * 2);
        context.fillStyle = (cyan ? 'rgba(125, 211, 252, ' : 'rgba(147, 197, 253, ') + (0.14 + Math.random() * 0.15).toFixed(3) + ')';
        context.fill();
      }
    }

    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(draw, 200);
    }, { passive: true });

    draw();
  })();
</script>
{% endif %}

