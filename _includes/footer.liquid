<script>
/* Keep the existing chat available. Load it during idle time after the page. */
(function () {
  if (!window.chatbase || window.chatbase('getState') !== 'initialized') {
    window.chatbase = function () { if (!window.chatbase.q) window.chatbase.q = []; window.chatbase.q.push(arguments); };
    window.chatbase = new Proxy(window.chatbase, { get: function (target, prop) { if (prop === 'q') return target.q; return function () { return target(prop, Array.prototype.slice.call(arguments)); }; } });
  }
  function load() { var s = document.createElement('script'); s.src = 'https://www.chatbase.co/embed.min.js'; s.id = 'dxCY_mFoNPQu83GSntHvw'; s.domain = 'www.chatbase.co'; document.body.appendChild(s); }
  function schedule() { setTimeout(function () { if ('requestIdleCallback' in window) window.requestIdleCallback(load, { timeout: 5000 }); else load(); }, 3000); }
  if (document.readyState === 'complete') schedule(); else window.addEventListener('load', schedule, { once: true });
})();
</script>
