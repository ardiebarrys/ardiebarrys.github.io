<link rel="stylesheet" href="{{ '/assets/css/site-experience.css' | relative_url }}">
<link rel="stylesheet" href="{{ '/assets/css/research-viewer.css' | relative_url }}">
<script src="{{ '/assets/js/research-viewer-tools.js' | relative_url }}" defer></script>
<script src="{{ '/assets/js/site-experience.js' | relative_url }}" defer></script>
<header class="site-header">
  <nav class="primary-nav" aria-label="Primary navigation">
    <a class="site-brand" href="{{ '/' | relative_url }}">Ardie Barry Sailis</a>
    <button class="mobile-nav-toggle" type="button" aria-expanded="false" aria-controls="primary-panel">Menu <span aria-hidden="true">☰</span></button>
    <div class="primary-panel" id="primary-panel">
      <ul class="primary-links">
        <li class="nav-dropdown">
          <button type="button" class="dropdown-toggle" aria-expanded="false" aria-controls="research-menu">Research <span aria-hidden="true">▾</span></button>
          <ul class="dropdown-panel" id="research-menu">
            {% for item in site.data.research_navigation %}
              {% if forloop.index == 2 %}<li><a href="{{ '/cellular-signaling-circuits/' | relative_url }}">Cellular Circuits (overview)</a></li>{% endif %}
              <li><a href="{{ item.url | relative_url }}" {% if item.url == page.url %}aria-current="page"{% endif %}>{{ item.title | escape }}</a></li>
            {% endfor %}
          </ul>
        </li>
        <li><a href="{{ '/publications/' | relative_url }}">Publications</a></li>
        <li class="nav-dropdown">
          <button type="button" class="dropdown-toggle" aria-expanded="false" aria-controls="about-menu">About <span aria-hidden="true">▾</span></button>
          <ul class="dropdown-panel" id="about-menu">
            <li><a href="{{ '/biography/' | relative_url }}">Biography</a></li>
            <li><a href="{{ '/cv/' | relative_url }}">CV</a></li>
            <li><a href="{{ '/talks/' | relative_url }}">Talks</a></li>
          </ul>
        </li>
        <li><a class="nav-contact" href="{{ '/contact/' | relative_url }}">Contact</a></li>
      </ul>
    </div>
  </nav>
</header>
