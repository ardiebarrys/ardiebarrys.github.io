<header>
  <nav id="navbar" class="navbar navbar-light {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation" aria-label="Primary navigation">
    <div class="navbar-layout">

      <div class="navbar-brand-slot">
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}<span class="font-weight-bold">{{- site.first_name -}}</span>{% endif %}
            {% if site.middle_name %}{{- site.middle_name -}}{% endif %}
            {% if site.last_name %}{{- site.last_name -}}{% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      </div>

      <input
        type="checkbox"
        id="navbar-menu-toggle"
        class="navbar-menu-toggle"
        aria-controls="navbarNav"
      >

      <label
        for="navbar-menu-toggle"
        class="navbar-menu-trigger"
        aria-label="Toggle navigation menu"
      >
        <span class="menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="menu-label">Menu</span>
      </label>

      <div class="navbar-collapse-main" id="navbarNav">
        <ul class="navbar-menu-list">
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {% if page.permalink == '/' %}<span class="nav-active-dot" aria-hidden="true"></span>{% endif %}
              <span>About</span>
              {% if page.permalink == '/' %}<span class="sr-only">(current)</span>{% endif %}
            </a>
          </li>

          {%- comment -%}
            Doctoral Research and Cellular Circuits are the two research tracks. They are
            nested under Projects behind a three-line toggle instead of sitting at the top
            level. The Projects page itself is unchanged.
          {%- endcomment -%}
          {% assign sub_pages = "/research/e-cigarettes-male-reproductive-health/,/cellular-signaling-circuits/" | split: "," %}
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}

          {%- assign sub_open = false -%}
          {%- for sp in sorted_pages -%}
            {%- if sub_pages contains sp.permalink and page.url contains sp.url -%}{%- assign sub_open = true -%}{%- endif -%}
          {%- endfor -%}

          {% for p in sorted_pages %}
            {% if p.nav and p.permalink != '/' and p.autogen == null %}
              {% unless sub_pages contains p.permalink %}
                {%- if p.permalink contains '://' -%}
                  {%- assign url = p.permalink -%}
                {%- elsif p.permalink contains '/blog/' -%}
                  {%- assign url = '/blog/' -%}
                {%- else -%}
                  {%- assign url = p.url -%}
                {%- endif -%}

                {% if p.permalink == '/projects/' %}
                  <li class="nav-item nav-has-sub {% if page.url contains p.url %}active{% endif %}">
                    <input type="checkbox" id="nav-projects-sub" class="nav-sub-input" {% if sub_open %}checked{% endif %}>
                    <div class="nav-sub-head">
                      <a class="nav-link" href="{{ url | relative_url }}">
                        {% if page.url contains p.url %}<span class="nav-active-dot" aria-hidden="true"></span>{% endif %}
                        <span>{{- p.title -}}</span>
                        {% if page.url contains p.url %}<span class="sr-only">(current)</span>{% endif %}
                      </a>
                      <label for="nav-projects-sub" class="nav-sub-trigger" aria-label="Show the two research tracks">
                        <span class="nav-sub-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                      </label>
                    </div>
                    <ul class="nav-sublist">
                      {% for sp in sorted_pages %}
                        {% if sp.nav and sub_pages contains sp.permalink %}
                          <li class="nav-item nav-special {% if sp.permalink == '/cellular-signaling-circuits/' %}nav-circuit-framework{% else %}nav-doctoral{% endif %} {% if page.url contains sp.url %}active{% endif %}">
                            <a class="nav-link" href="{{ sp.url | relative_url }}">
                              {% if page.url contains sp.url %}<span class="nav-active-dot" aria-hidden="true"></span>{% endif %}
                              <span>{{- sp.title -}}</span>
                              {% if page.url contains sp.url %}<span class="sr-only">(current)</span>{% endif %}
                            </a>
                          </li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  </li>
                {% else %}
                  <li class="nav-item {% if page.url contains p.url %}active{% endif %}">
                    <a class="nav-link" href="{{ url | relative_url }}">
                      {% if page.url contains p.url %}<span class="nav-active-dot" aria-hidden="true"></span>{% endif %}
                      <span>{{- p.title -}}</span>
                      {% if page.url contains p.url %}<span class="sr-only">(current)</span>{% endif %}
                    </a>
                  </li>
                {% endif %}
              {% endunless %}
            {% endif %}
          {% endfor %}
        </ul>
      </div>

    </div>
  </nav>
</header>
