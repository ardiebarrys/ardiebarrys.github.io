<a class="site-skip" href="#site-content">Skip to content</a>
<header class="site-header">
  <nav id="navbar" class="navbar" aria-label="Primary navigation">
    <div class="navbar-layout">
      <a class="site-brand" href="{{ '/' | relative_url }}" aria-label="Ardie Barry Sailis, home">
        <span class="site-monogram" aria-hidden="true">AB</span>
        <span>Ardie Barry Sailis</span>
      </a>
      <div class="site-primary-links">
        <a href="{{ '/projects/' | relative_url }}" {% if page.url == '/projects/' %}aria-current="page"{% endif %}>Research</a>
        <a href="{{ '/publications/' | relative_url }}" {% if page.url == '/publications/' %}aria-current="page"{% endif %}>Publications</a>
        <a href="{{ '/biography/' | relative_url }}" {% if page.url == '/biography/' %}aria-current="page"{% endif %}>About</a>
        <a href="{{ '/contact/' | relative_url }}" {% if page.url == '/contact/' %}aria-current="page"{% endif %}>Contact</a>
      </div>
      <details class="site-menu" id="site-menu">
        <summary class="site-menu-trigger"><span>Menu</span><span class="site-menu-icon" aria-hidden="true"><i></i><i></i></span></summary>
        <div class="site-menu-panel" id="site-menu-panel">
          <div class="site-menu-content">
            <div class="site-menu-top"><span class="site-eyebrow">Explore the site</span><button type="button" data-menu-close hidden aria-label="Close menu">Close <span aria-hidden="true">×</span></button></div>
            <div class="site-menu-grid">
              <div>
                <p class="site-menu-label">Portfolio</p>
                <ul class="site-menu-pages">
                  {%- assign menu_paths = '/|/projects/|/publications/|/biography/|/talks/|/cv/|/contact/|/deep-numbers/' | split: '|' -%}
                  {%- assign menu_labels = 'Home|Research|Publications|Biography|Talks|Curriculum vitae|Contact|Deep Numbers' | split: '|' -%}
                  {% for path in menu_paths %}
                  <li><a href="{{ path | relative_url }}" {% if page.url == path %}aria-current="page"{% endif %}><span>{{ menu_labels[forloop.index0] }}</span><span aria-hidden="true">↗</span></a></li>
                  {% endfor %}
                </ul>
              </div>
              <div class="site-menu-research">
                <p class="site-menu-label">Research in focus</p>
                <a href="{{ '/research/e-cigarettes-male-reproductive-health/' | relative_url }}"><small>Doctoral research</small><strong>Vaping and reproductive health</strong></a>
                <a href="{{ '/cellular-signaling-circuits/' | relative_url }}"><small>Independent framework</small><strong>Cellular signaling circuits</strong></a>
                <ul>
                  <li><a href="{{ '/research/upr-proteotoxic-stress-resolution/' | relative_url }}">UPR and proteotoxic stress <span aria-hidden="true">↗</span></a></li>
                  <li><a href="{{ '/research/yap-taz-signal-resolution/' | relative_url }}">YAP/TAZ and mechanical signals <span aria-hidden="true">↗</span></a></li>
                  <li><a href="{{ '/research/nrf2-keap1-redoxostat/' | relative_url }}">NRF2–KEAP1 and redox balance <span aria-hidden="true">↗</span></a></li>
                  <li><a href="{{ '/research/cyp1a1-metabolic-feedback/' | relative_url }}">CYP1A1 and metabolic feedback <span aria-hidden="true">↗</span></a></li>
                  <li><a href="{{ '/research/transcriptional-condensates-kinetic-filters/' | relative_url }}">Condensates and signal timing <span aria-hidden="true">↗</span></a></li>
                </ul>
              </div>
            </div>
            <div class="site-menu-bottom"><span>Independent research. Open questions.</span><a href="mailto:ardiebarrys@gmail.com">ardiebarrys@gmail.com</a></div>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
<div id="site-content" class="site-content-anchor" tabindex="-1"></div>
{% unless page.url == '/' or page.url == '/deep-numbers/' %}
<nav class="site-breadcrumbs" aria-label="Breadcrumb">
  <a href="{{ '/' | relative_url }}">Home</a><span aria-hidden="true">/</span>
  {% if page.url contains '/research/' %}<a href="{{ '/projects/' | relative_url }}">Research</a><span aria-hidden="true">/</span>{% endif %}
  <span aria-current="page">{{ page.title }}</span>
</nav>
{% endunless %}
